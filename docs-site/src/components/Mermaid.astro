---
// Client-side mermaid renderer — 3 diagrams in the docs, not worth a
// build-time pipeline. Source passes through as slot text; the script
// renders it in place. Diagrams must avoid < > & in labels (ours do).
---

<span class="mermaid-src"><slot /></span>

<script>
  import mermaid from "mermaid";

  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  const theme =
    document.documentElement.dataset.theme === "dark" || prefersDark ? "dark" : "default";
  mermaid.initialize({
    startOnLoad: false,
    theme,
    securityLevel: "loose",
    fontFamily: "var(--sl-font-mono, ui-monospace, monospace)",
  });

  for (const el of document.querySelectorAll(".mermaid-src")) {
    const src = el.textContent ?? "";
    el.textContent = "";
    const { svg } = await mermaid.render(
      `mmd-${Math.random().toString(36).slice(2)}`,
      src.trim(),
    );
    const wrap = document.createElement("span");
    wrap.className = "mermaid-wrap";
    wrap.innerHTML = svg;
    el.replaceWith(wrap);
  }
</script>
